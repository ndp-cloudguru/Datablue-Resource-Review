### Java template
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
.idea/

# Source Code Directories (Keep .gitkeep)
source-code/*
!source-code/.gitkeep

# Build & Dependency Directories
**/node_modules/
**/dist/
**/target/
.DS_Store

# Operation Build Artifacts (Backend JARs, Frontend dists, metadata)
operation/builds/backend/*
!operation/builds/backend/.gitkeep
operation/builds/frontend/*
!operation/builds/frontend/.gitkeep
# Secrets & Credentials
.mvn-credentials*

